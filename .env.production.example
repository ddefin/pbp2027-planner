# Fichier réel : .env.production, à créer UNE FOIS directement sur le NAS
# (via SSH ou File Station), jamais committé, jamais poussé sur GitHub.
# docker-compose.yml le charge automatiquement.

# Chemin à l'intérieur du conteneur — correspond au volume ./data monté par
# docker-compose.yml. Ne pas changer sauf à changer aussi ce volume.
DATABASE_URL="file:/app/data/prod.db"

PORT=3001

# openssl rand -hex 32
MFA_ENCRYPTION_KEY=""

TOTP_ISSUER="PBP2027 Planner"

# true : le reverse proxy DSM sert l'app en HTTPS, donc le cookie de session
# doit exiger Secure.
COOKIE_SECURE=true

# Optionnelle — météo live désactivée si vide.
OPENWEATHER_API_KEY=""

# Optionnelle — "mot de passe oublié" désactivé (répond "non configuré") si
# SMTP_HOST est vide. Une boîte mail existante (ex. SMTP OVH : ssl0.ovh.net, port
# 465/587), pas un nouveau service à créer.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Optionnelle — à ne renseigner que si les liens envoyés par email pointent vers la
# mauvaise adresse (sinon déduite automatiquement de la requête).
PUBLIC_URL="https://pbp2027.lameteoducyclo.fr"
