datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                     String                @id @default(cuid())
  email                  String                @unique
  prenom                 String
  isAdmin                Boolean               @default(false)
  passwordHash           String
  // Profil (page "Mon profil") : tout optionnel, rien de bloquant pour le reste
  // de l'app si laissé vide.
  licenceNumero          String? // numéro de licence FFCT/ACP, utile pour l'homologation
  club                   String?
  notebook               String? // carnet de bord personnel, texte libre (matériel, nutrition, notes de brevet...)
  failedLoginAttempts    Int                   @default(0)
  lockedUntil            DateTime?
  createdAt              DateTime              @default(now())
  sessions               Session[]
  passwordResetTokens    PasswordResetToken[]
  personalEvents         PersonalEvent[]
  licenseDocuments       LicenseDocument[]
  brmEvents              BrmEvent[]
  brmParticipations      BrmParticipation[]
  webhookSubscriptions   WebhookSubscription[]
  groupMessages          GroupMessage[]
  sentDirectMessages     DirectMessage[]       @relation("DmSender")
  receivedDirectMessages DirectMessage[]       @relation("DmRecipient")
  catalogTracks          CatalogTrack[]
  catalogTrackVariants   CatalogTrackVariant[]
  catalogControlPoints   CatalogControlPoint[]
  telegramLink           TelegramLink?
  stravaAccount          StravaAccount?
  stravaActivities       StravaActivity[]
  coachPrefs             CoachPrefs?
  telegramLinkCodes      TelegramLinkCode[]
  notifications          Notification[]
  pbpRoutes              PbpRoute[]
  roadbooks              Roadbook[]
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  userAgent  String?
  ip         String?
}

// Jeton de réinitialisation de mot de passe oublié, envoyé par email. À usage
// unique (supprimé dès utilisation) et de courte durée de vie — voir
// src/routes/auth.ts.
model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Un BRM (Brevet Randonneur Mondial) de qualification pour le PBP.
// distance en km (200/300/400/600, validé côté application) ; les durées
// sont stockées en minutes pour éviter l'ambiguïté de parsing de chaînes "Xh YY".
model BrmEvent {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  distance            Int
  date                DateTime
  lieu                String
  status              String    @default("a-venir")
  limiteMinutes       Int
  tempsRealiseMinutes Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  parcours            Parcours?

  @@index([userId])
}

// Le parcours d'un BRM personnel : fichier GPX (uploadé ou récupéré automatiquement
// depuis OpenRunner), stats qui en sont dérivées, et les notes pratiques pour
// l'ultra-distance. La météo n'est plus saisie ici : voir GET /brm/:id/meteo
// (OpenWeatherMap, live + prévisions), aucune donnée manuelle à maintenir à jour.
model Parcours {
  id         String   @id @default(cuid())
  brmEventId String   @unique
  brmEvent   BrmEvent @relation(fields: [brmEventId], references: [id], onDelete: Cascade)

  sourceUrl    String? // lien OpenRunner (ou autre) d'où les stats ont été récupérées
  fileName     String?
  fileData     Bytes? // ancien stockage, conservé en lecture pour les fichiers déjà en base (voir src/lib/fileStorage.ts)
  filePath     String? // nouveau stockage : chemin relatif sous ./data/uploads
  fileMimeType String?

  distanceKm     Float?
  elevationGainM Int?
  elevationLossM Int?
  minAltitudeM   Int?
  maxAltitudeM   Int?

  notes String? // ravitos, points de vigilance, tout ce qui aide en ultra-distance

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// Le choix d'un randonneur sur un BRM du calendrier officiel ACP (pas un événement
// qu'on stocke nous-mêmes : catalogEventId est dérivé de manière stable des champs
// ACP, voir src/lib/acpCatalog.ts). Visible par tous les utilisateurs connectés.
model BrmParticipation {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogEventId String
  status         String   @default("prevu")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, catalogEventId])
  @@index([catalogEventId])
}

// Abonnement webhook configuré par un utilisateur, mais déclenché pour TOUT le groupe
// (ex. un webhook Discord pointant sur le salon du club) : c'est le même modèle que la
// visibilité des participations BRM, pensé pour la coordination collective plutôt que
// pour des notifications strictement privées.
model WebhookSubscription {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  url             String
  format          String // "discord" | "slack" | "generic"
  events          String // liste d'événements séparés par des virgules (voir src/lib/webhooks.ts)
  secretEncrypted String? // uniquement pour le format "generic" (signature HMAC), chiffré au repos
  enabled         Boolean   @default(true)
  createdAt       DateTime  @default(now())
  lastTriggeredAt DateTime?
  lastStatus      String? // "ok" | "error"

  @@index([userId])
}

// Salon général : un seul fil, visible par tous les randonneurs connectés.
model GroupMessage {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text         String
  // "text" | "location" | "file" — lat/lon renseignés seulement pour "location",
  // fileName/fileMimeType/fileData seulement pour "file" (contenu stocké tel quel,
  // comme les GPX de Parcours/CatalogTrack — pas de stockage externe pour l'instant).
  kind         String   @default("text")
  lat          Float?
  lon          Float?
  fileName     String?
  fileMimeType String?
  fileData     Bytes? // ancien stockage, conservé en lecture (voir src/lib/fileStorage.ts)
  filePath     String? // nouveau stockage : chemin relatif sous ./data/uploads
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// Message privé entre deux randonneurs. readAt sert à compter les messages non
// lus dans la liste des conversations (jamais renvoyé comme preuve de lecture
// à l'expéditeur pour l'instant, juste utilisé côté destinataire).
model DirectMessage {
  id           String    @id @default(cuid())
  senderId     String
  sender       User      @relation("DmSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId  String
  recipient    User      @relation("DmRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  text         String
  kind         String    @default("text")
  lat          Float?
  lon          Float?
  fileName     String?
  fileMimeType String?
  fileData     Bytes? // ancien stockage, conservé en lecture (voir src/lib/fileStorage.ts)
  filePath     String? // nouveau stockage : chemin relatif sous ./data/uploads
  createdAt    DateTime  @default(now())
  readAt       DateTime?

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, senderId, createdAt])
}

// Tracé GPX pour un BRM du calendrier ACP (pas un BrmEvent saisi manuellement, voir
// Parcours) : un seul tracé par événement, partagé par tout le groupe — n'importe
// quel randonneur peut l'ajouter ou le remplacer, comme pour les autres informations
// collectives de l'app (participations, sorties). points est un tableau JSON
// [{lat,lon}, ...] déjà décimé (voir src/lib/gpx.ts), prêt pour l'affichage Leaflet.
model CatalogTrack {
  id               String   @id @default(cuid())
  catalogEventId   String   @unique
  uploadedByUserId String
  uploadedBy       User     @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)
  fileName         String
  points           String
  distanceKm       Float?
  elevationGainM   Int?
  elevationLossM   Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Variante de tracé pour un BRM du calendrier ACP : contrairement à CatalogTrack
// (LE tracé de référence, un seul par événement, remplaçable par n'importe qui),
// plusieurs variantes peuvent coexister — pensé pour comparer plusieurs options
// (ex. un itinéraire évitant une route dangereuse) plutôt que pour désigner "le
// bon" tracé. Chacun ne peut retirer que ses propres variantes.
model CatalogTrackVariant {
  id               String   @id @default(cuid())
  catalogEventId   String
  uploadedByUserId String
  uploadedBy       User     @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)
  label            String // ex. "Variante évitant Nogent" — saisi à l'upload
  fileName         String
  points           String
  distanceKm       Float?
  elevationGainM   Int?
  elevationLossM   Int?
  createdAt        DateTime @default(now())

  @@index([catalogEventId])
}

// Point de ravito/contrôle/départ/arrivée sur un BRM du calendrier ACP, affiché
// sur la carte en plus du tracé et inclus dans l'export GPX enrichi (voir
// web/src/lib/gpxExport.ts). Collectif comme CatalogTrack : visible par tous,
// chacun ne peut retirer que ses propres points.
model CatalogControlPoint {
  id              String   @id @default(cuid())
  catalogEventId  String
  createdByUserId String
  createdBy       User     @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  kind            String // "ravito" | "controle" | "depart" | "arrivee"
  label           String
  lat             Float
  lon             Float
  createdAt       DateTime @default(now())

  @@index([catalogEventId])
}

// Déduplique les alertes météo (vent fort) : au plus une par BRM du calendrier
// ACP et par jour de prévision concerné, même si la vérification périodique
// (voir src/lib/windAlerts.ts) tourne plusieurs fois avant le départ.
model WindAlertSent {
  id             String   @id @default(cuid())
  catalogEventId String
  forecastDate   String // yyyy-mm-dd
  createdAt      DateTime @default(now())

  @@unique([catalogEventId, forecastDate])
}

// Événement personnel (page "Mon profil") : entièrement privé à son auteur,
// contrairement aux Sorties ou au calendrier BRM qui sont collectifs — un
// randonneur y note ce qu'il veut (sortie d'entraînement, rendez-vous médical,
// rappel de renouvellement de licence...), rien n'est partagé au groupe.
model PersonalEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

// Licence FFCT/ACP scannée ou photographiée (PDF/PNG/JPEG), page "Mon profil".
// Pas de notion de "courante" en base : la plus récente (createdAt) l'est
// implicitement, les autres forment l'archive — un nouvel upload n'écrase
// jamais les précédents, pensé pour garder une collection au fil des ans.
model LicenseDocument {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName     String
  fileMimeType String
  filePath     String
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

// Actualité agrégée depuis les sites sources (ACP, PBP) — voir
// src/lib/newsScraper.ts. url sert de clé de dédoublonnage : un article déjà vu
// n'est jamais ré-inséré ni rediffusé sur Telegram, même si le scraping
// quotidien retombe dessus (les pages sources listent les derniers articles à
// chaque passage, pas seulement les nouveaux depuis la dernière fois).
model NewsItem {
  id           String   @id @default(cuid())
  source       String // "acp" | "pbp"
  title        String
  url          String   @unique
  excerpt      String?
  imageUrl     String?
  publishedAt  DateTime // date affichée sur le site source
  discoveredAt DateTime @default(now()) // quand NOUS l'avons vu pour la 1re fois

  @@index([source, publishedAt])
}

// Lien entre un compte de l'app et un chat Telegram, pour les notifications
// personnalisées en message privé (ex. changement de statut sur un BRM), en plus
// de la diffusion de groupe des actualités (voir TELEGRAM_NEWS_CHAT_ID).
// Établi en envoyant "/start <code>" au bot (voir src/lib/telegramBot.ts), le
// code venant de TelegramLinkCode ci-dessous.
model TelegramLink {
  id       String   @id @default(cuid())
  userId   String   @unique
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId   String   @unique
  linkedAt DateTime @default(now())
}

// Code à usage unique affiché dans "Mon profil" le temps que l'utilisateur
// l'envoie au bot ("/start <code>") — consommé dès la liaison réussie, courte
// durée de vie pour qu'un code affiché puis oublié ne traîne pas indéfiniment.
model TelegramLinkCode {
  code      String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Notification personnelle in-app (cloche dans la barre du haut) : créée en plus
// — pas à la place — d'une notif Telegram si le compte est lié, pour que
// l'information reste visible dans l'app même sans rien configurer. readAt nul
// = non lue.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // "brm_status" pour l'instant, pensé extensible
  message   String
  link      String?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userId, createdAt])
}

// Tracé du parcours PBP (page "Parcours PBP") : le parcours 2027 définitif n'est pas
// encore publié, donc plusieurs tracés coexistent — "provisoire" (proposé par un
// admin), "communautaire" (n'importe quel randonneur) et, le jour venu, "officiel".
// Le tracé affiché par défaut est le plus récent de plus haut rang (officiel >
// provisoire > communautaire) : importer le GPX officiel suffit à basculer tout le
// monde dessus, sans rien supprimer (les autres restent comparables). points est un
// tableau JSON compact [[lat, lon, ele|null, distKm], ...] déjà simplifié (Douglas-
// Peucker 3D, voir src/lib/geo.ts) ; le GPX d'origine reste sur disque (filePath)
// pour pouvoir le retélécharger ou le retraiter si l'algorithme évolue.
model PbpRoute {
  id               String   @id @default(cuid())
  label            String
  kind             String // "officiel" | "provisoire" | "communautaire"
  description      String?
  fileName         String
  filePath         String
  points           String
  waypoints        String // [{name, lat, lon}] issus des <wpt> du GPX
  distanceKm       Float
  elevationGainM   Int?
  elevationLossM   Int?
  rawPointCount    Int
  uploadedByUserId String
  uploadedBy       User     @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([kind, createdAt])
}

// Roadbook personnel d'un BRM (page "Roadbook") : un GPX analysé + le plan de marche
// de son auteur (vitesse roulée, pauses par contrôle) + son suivi live. Les calculs
// (heures de passage, barrières ACP, avance/retard) sont faits côté client à partir
// de ces réglages (web/src/lib/roadbook.ts) : rien de dérivé n'est stocké, changer
// la vitesse ou une pause n'oblige à rien recalculer en base.
model Roadbook {
  id                     String            @id @default(cuid())
  userId                 String
  user                   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                  String
  classKm                Int // 200/300/400/600, ou distance nominale d'un format sur-mesure
  limitMinutes           Int
  startAt                DateTime?
  movingSpeedKmh         Float             @default(22)
  climbPenaltyMinPer100m Float             @default(0)
  controls               String // [{name, km, stopMinutes, lat, lon}] triés par km
  pois                   String // [{name, km, lat, lon}] waypoints GPX non retenus comme contrôles
  points                 String // [[lat, lon, ele|null, km], ...] simplifiés (voir src/lib/geo.ts)
  distanceKm             Float
  elevationGainM         Int?
  elevationLossM         Int?
  fileName               String
  filePath               String
  // Lien de partage public en lecture seule (suivi par les proches) : null = non
  // partagé. Jeton aléatoire de 128 bits, révocable/régénérable par l'auteur.
  shareToken             String?           @unique
  // Lien de suivi du compteur GPS (Garmin LiveTrack) : affiché aux proches et dans
  // le canal Telegram, jamais interrogé par le serveur (pas d'API ouverte).
  liveTrackUrl           String?
  // Publier un résumé de situation sur le canal Telegram du groupe à chaque pointage
  // (opt-out possible : ce sont les positions de la personne).
  telegramAnnounce       Boolean           @default(true)
  lastAnnouncedAt        DateTime?
  // Résultat de la DERNIÈRE tentative de publication sur le canal : null = réussie,
  // sinon le motif renvoyé par Telegram (affiché au randonneur dans son roadbook).
  lastAnnounceError      String?
  lastAnnounceAttemptAt  DateTime?
  // Check-list de préparation : [{id, label, done}] (la liste type est fournie par l'app).
  checklist              String            @default("[]")
  checkins               RoadbookCheckin[]
  alerts                 RoadbookAlert[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([userId, createdAt])
}

// Position déclarée pendant le brevet (GPS ou saisie manuelle du km) : seule la plus
// récente sert au statut, les précédentes forment l'historique visible en partage.
model RoadbookCheckin {
  id         String   @id @default(cuid())
  roadbookId String
  roadbook   Roadbook @relation(fields: [roadbookId], references: [id], onDelete: Cascade)
  km         Float
  lat        Float?
  lon        Float?
  source     String // "gps" | "manuel" | "controle"
  at         DateTime @default(now())
  // Identifiant généré par le téléphone : un pointage mis en file hors réseau puis
  // renvoyé (parfois alors que le premier envoi était en fait passé, réponse perdue) ne
  // doit jamais être enregistré deux fois. Nul pour les pointages sans file (Telegram).
  clientId   String?

  @@unique([roadbookId, clientId])
  @@index([roadbookId, at])
}

// Groupes/canaux où le bot a été ajouté (ou dans lesquels il voit passer des messages),
// découverts automatiquement via les mises à jour Telegram : sert à afficher à l'admin
// l'identifiant EXACT du canal à mettre dans TELEGRAM_TRACKING_CHAT_ID, au lieu de le
// chercher à la main (source d'erreurs "chat not found").
model TelegramChat {
  chatId    String   @id
  title     String
  type      String // "channel" | "supergroup" | "group"
  botStatus String? // "administrator" | "member" | "left" | "kicked" | null si inconnu
  updatedAt DateTime @updatedAt
}

// Alertes déjà envoyées sur le canal pour un roadbook (silence prolongé, fermeture de
// contrôle dépassée, météo à venir...) : évite de répéter la même alerte à chaque passage
// de la vérification périodique. `key` décrit la situation (ex. "silence:<dernier
// pointage>:2", "weather:vent_de_face") ; `sentAt` sert aux alertes qui peuvent se
// répéter après un délai.
model RoadbookAlert {
  id         String   @id @default(cuid())
  roadbookId String
  roadbook   Roadbook @relation(fields: [roadbookId], references: [id], onDelete: Cascade)
  key        String
  sentAt     DateTime @default(now())

  @@unique([roadbookId, key])
}

// Page du site officiel surveillée pour détecter un changement (ex. publication du
// parcours détaillé du PBP) : dernière empreinte du contenu, état « parcours annoncé
// pour plus tard » et liens de parcours trouvés, pour ne signaler que les VRAIS
// changements (voir src/lib/pbpRouteWatch.ts).
model WatchedPage {
  key            String    @id
  contentHash    String
  routePending   Boolean
  routeLinks     String // JSON : liens vers un tracé (gpx, OpenRunner, Komoot...) trouvés
  checkedAt      DateTime
  changedAt      DateTime?
  lastNotifiedAt DateTime?
}

// Compte Strava lié (OAuth2 v3). Les jetons sont chiffrés au repos (AES-256-GCM, même
// clé que les autres secrets) : une fuite de la base seule ne donne pas accès à Strava.
model StravaAccount {
  userId        String    @id
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  athleteId     String    @unique
  athleteName   String
  profilePhoto  String?
  accessToken   String // chiffré
  refreshToken  String // chiffré (Strava peut le renouveler à chaque rafraîchissement)
  expiresAt     DateTime // expiration du jeton d'accès (6 h)
  scope         String
  // Réglages du sportif récupérés avec profile:read_all : FC max, FTP, zones.
  ftp           Int?
  maxHr         Int?
  hrZones       String? // [[min,max],...] en bpm
  connectedAt   DateTime  @default(now())
  lastSyncAt    DateTime?
  lastSyncError String?
}

// Activités synchronisées : seulement ce qui sert aux analyses (pas de tracé GPS ni de
// streams). `startLocal` = heure murale locale de la sortie, stockée comme si elle était UTC
// (c'est le jour que voit le sportif qui compte pour les semaines et les jours).
model StravaActivity {
  id            String   @id // identifiant Strava
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  sportType     String
  startDate     DateTime
  startLocal    DateTime
  distanceM     Float
  movingSec     Int
  elevationM    Float
  avgHr         Float?
  maxHr         Float?
  avgWatts      Float?
  weightedWatts Float?
  avgSpeedMs    Float?
  load          Float // charge estimée (équivalent TSS), voir src/lib/stravaMetrics.ts
  zone          Int? // zone d'intensité 1-5 estimée d'après la FC ou la puissance moyenne

  @@index([userId, startLocal])
}

// Réglages du Coach (analyse et bilans automatiques), indépendants de la connexion Strava.
model CoachPrefs {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile       String   @default("endurance") // endurance | performance | forme
  tone          String   @default("bienveillant") // bienveillant | direct | technique
  frequency     String   @default("hebdo") // activite | hebdo | demande
  metrics       String   @default("[\"hr\",\"elevation\"]") // hr | power | elevation | speed
  goal          String?
  lastReportKey String?
  updatedAt     DateTime @updatedAt
}

// Journal des événements de compte (mot de passe oublié, verrouillage, réinitialisation),
// lisible par les administrateurs dans la page Administration pour comprendre un blocage.
// Conservé 60 jours. Pas de mot de passe ni de jeton dans ce journal.
model AuthEvent {
  id        String   @id @default(cuid())
  email     String // adresse saisie (le compte peut ne pas exister)
  kind      String // reset_requested | reset_no_account | mail_sent | mail_failed | reset_ok | reset_token_invalid | login_locked
  detail    String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([createdAt])
}
