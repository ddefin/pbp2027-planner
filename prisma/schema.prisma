datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String         @id @default(cuid())
  email                String         @unique
  passwordHash         String
  mfaEnabled           Boolean        @default(false)
  mfaSecretEncrypted   String?
  mfaPendingEncrypted  String?
  failedLoginAttempts  Int            @default(0)
  lockedUntil          DateTime?
  createdAt            DateTime       @default(now())
  sessions             Session[]
  recoveryCodes        RecoveryCode[]
  mfaChallenges        MfaChallenge[]
  brmEvents            BrmEvent[]
  brmParticipations    BrmParticipation[]
  sortiesCreees        Sortie[]            @relation("SortieCreateur")
  sortieParticipations SortieParticipant[]
  chatMessages         ChatMessage[]
  webhookSubscriptions WebhookSubscription[]
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  userAgent  String?
  ip         String?
}

// Jeton temporaire émis entre "mot de passe validé" et "code MFA validé".
// Ne donne jamais accès à une ressource protégée tant que verified=false.
model MfaChallenge {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Un BRM (Brevet Randonneur Mondial) de qualification pour le PBP.
// distance en km (200/300/400/600, validé côté application) ; les durées
// sont stockées en minutes pour éviter l'ambiguïté de parsing de chaînes "Xh YY".
model BrmEvent {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  distance             Int
  date                 DateTime
  lieu                 String
  status               String    @default("a-venir")
  limiteMinutes        Int
  tempsRealiseMinutes  Int?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  parcours             Parcours?

  @@index([userId])
}

// Le parcours d'un BRM personnel : fichier GPX (uploadé ou récupéré automatiquement
// depuis OpenRunner), stats qui en sont dérivées, et les notes pratiques pour
// l'ultra-distance. La météo n'est plus saisie ici : voir GET /brm/:id/meteo
// (OpenWeatherMap, live + prévisions), aucune donnée manuelle à maintenir à jour.
model Parcours {
  id                String   @id @default(cuid())
  brmEventId        String   @unique
  brmEvent          BrmEvent @relation(fields: [brmEventId], references: [id], onDelete: Cascade)

  sourceUrl         String? // lien OpenRunner (ou autre) d'où les stats ont été récupérées
  fileName          String?
  fileData          Bytes? // contenu du GPX, stocké tel quel (petits fichiers, pas de stockage externe pour l'instant)
  fileMimeType      String?

  distanceKm        Float?
  elevationGainM    Int?
  elevationLossM    Int?
  minAltitudeM      Int?
  maxAltitudeM      Int?

  notes             String? // ravitos, points de vigilance, tout ce qui aide en ultra-distance

  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
}

// Le choix d'un randonneur sur un BRM du calendrier officiel ACP (pas un événement
// qu'on stocke nous-mêmes : catalogEventId est dérivé de manière stable des champs
// ACP, voir src/lib/acpCatalog.ts). Visible par tous les utilisateurs connectés.
model BrmParticipation {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogEventId String
  status         String   @default("prevu")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, catalogEventId])
  @@index([catalogEventId])
}

// Une sortie d'entraînement coordonnée par le groupe (distincte des BRM officiels).
model Sortie {
  id           String              @id @default(cuid())
  titre        String
  date         DateTime
  lieu         String
  createdById  String
  createdBy    User                @relation("SortieCreateur", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt    DateTime            @default(now())
  participants SortieParticipant[]
  messages     ChatMessage[]
}

model SortieParticipant {
  id       String   @id @default(cuid())
  sortieId String
  sortie   Sortie   @relation(fields: [sortieId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([sortieId, userId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  sortieId  String
  sortie    Sortie   @relation(fields: [sortieId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([sortieId, createdAt])
}

// Abonnement webhook configuré par un utilisateur, mais déclenché pour TOUT le groupe
// (ex. un webhook Discord pointant sur le salon du club) : c'est le même modèle que la
// visibilité des participations BRM, pensé pour la coordination collective plutôt que
// pour des notifications strictement privées.
model WebhookSubscription {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  url             String
  format          String // "discord" | "slack" | "generic"
  events          String // liste d'événements séparés par des virgules (voir src/lib/webhooks.ts)
  secretEncrypted String? // uniquement pour le format "generic" (signature HMAC), chiffré au repos
  enabled         Boolean   @default(true)
  createdAt       DateTime  @default(now())
  lastTriggeredAt DateTime?
  lastStatus      String? // "ok" | "error"

  @@index([userId])
}
